{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Server",
			"type": "go",
			"request": "launch",
			"mode": "debug",
			"program": "${workspaceFolder}/cmd/nomad",
			"cwd": "${workspaceFolder}",
			"env": {
				"NOMAD_LISTEN": ":6060",
				"NOMAD_CONFIG_DIR": "${workspaceFolder}/config",
				"NOMAD_DATA_DIR": "${workspaceFolder}/data",
				"NOMAD_DEBUG": "1"
			}
		},
		{
			"name": "Server (web app)",
			"type": "go",
			"request": "launch",
			"mode": "debug",
			"program": "${workspaceFolder}/cmd/nomad",
			"cwd": "${workspaceFolder}",
			"preLaunchTask": "Build web client",
			"env": {
				"NOMAD_LISTEN": ":6060",
				"NOMAD_CONFIG_DIR": "${workspaceFolder}/config",
				"NOMAD_DATA_DIR": "${workspaceFolder}/data",
				"NOMAD_WEB_DIR": "${workspaceFolder}/client/build/web",
				"NOMAD_DEBUG": "1"
			}
		},
		{
			"name": "Client",
			"type": "dart",
			"request": "launch",
			"program": "lib/main.dart",
			"cwd": "${workspaceFolder}/client"
		},
		{
			"name": "Server tests (end-to-end)",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${workspaceFolder}/internal/app"
		},
		{
			"name": "Server tests (chunker)",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${workspaceFolder}/internal/chunker"
		},
		{
			"name": "Client tests",
			"type": "dart",
			"request": "launch",
			"program": "test/",
			"cwd": "${workspaceFolder}/client",
			"toolArgs": [
				"--exclude-tags",
				"integration"
			]
		},
		{
			"name": "Client ↔ real server tests",
			"type": "dart",
			"request": "launch",
			"program": "test/integration/real_server_test.dart",
			"cwd": "${workspaceFolder}/client",
			"env": {
				"NOMAD_SERVER_DIR": "${workspaceFolder}"
			}
		}
	],
	"compounds": [
		{
			"name": "Server + Client",
			"configurations": [
				"Server",
				"Client"
			],
			"stopAll": true
		}
	]
}