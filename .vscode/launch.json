{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Server",
			"type": "go",
			"request": "launch",
			"mode": "debug",
			"program": "${workspaceFolder}/cmd/polder",
			"cwd": "${workspaceFolder}",
			"env": {
				"POLDER_LISTEN": ":6060",
				"POLDER_CONFIG_DIR": "${workspaceFolder}/config",
				"POLDER_DATA_DIR": "${workspaceFolder}/data",
				"POLDER_DEBUG": "1"
			}
		},
		{
			"name": "Server (web app)",
			"type": "go",
			"request": "launch",
			"mode": "debug",
			"program": "${workspaceFolder}/cmd/polder",
			"cwd": "${workspaceFolder}",
			"preLaunchTask": "Build web client",
			"env": {
				"POLDER_LISTEN": ":6060",
				"POLDER_CONFIG_DIR": "${workspaceFolder}/config",
				"POLDER_DATA_DIR": "${workspaceFolder}/data",
				"POLDER_WEB_DIR": "${workspaceFolder}/client/build/web",
				"POLDER_DEBUG": "1"
			}
		},
		{
			"name": "Server (Collabora)",
			"type": "go",
			"request": "launch",
			"mode": "debug",
			"program": "${workspaceFolder}/cmd/polder",
			"cwd": "${workspaceFolder}",
			"preLaunchTask": "Start collabora online docker",
			"env": {
				"POLDER_LISTEN": ":6060",
				"POLDER_CONFIG_DIR": "${workspaceFolder}/config",
				"POLDER_DATA_DIR": "${workspaceFolder}/data",
				"POLDER_COLLABORA_URL": "http://localhost:9980",
				"POLDER_WOPI_URL": "http://host.docker.internal:6060",
				"POLDER_DEBUG": "1"
			}
		},
		{
			"name": "Server (Euro-Office)",
			"type": "go",
			"request": "launch",
			"mode": "debug",
			"program": "${workspaceFolder}/cmd/polder",
			"cwd": "${workspaceFolder}",
			"preLaunchTask": "Start euro office docker",
			"env": {
				"POLDER_LISTEN": ":6060",
				"POLDER_CONFIG_DIR": "${workspaceFolder}/config",
				"POLDER_DATA_DIR": "${workspaceFolder}/data",
				"POLDER_EURO_OFFICE_URL": "http://localhost:9981",
				"POLDER_WOPI_URL": "http://host.docker.internal:6060",
				"POLDER_DEBUG": "1"
			}
		},
		{
			"name": "Client",
			"type": "dart",
			"request": "launch",
			"program": "lib/main.dart",
			"cwd": "${workspaceFolder}/client"
		},
		{
			"name": "Client (Profile)",
			"args": [
				"--profile"
			],
			"type": "dart",
			"request": "launch",
			"program": "lib/main.dart",
			"cwd": "${workspaceFolder}/client"
		},
		{
			"name": "Server tests (end-to-end)",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${workspaceFolder}/internal/app"
		},
		{
			"name": "Server tests (chunker)",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${workspaceFolder}/internal/chunker"
		},
		{
			"name": "Client tests",
			"type": "dart",
			"request": "launch",
			"program": "test/",
			"cwd": "${workspaceFolder}/client",
			"toolArgs": [
				"--exclude-tags",
				"integration"
			]
		},
		{
			"name": "Client ↔ real server tests",
			"type": "dart",
			"request": "launch",
			"program": "test/integration/real_server_test.dart",
			"cwd": "${workspaceFolder}/client",
			"env": {
				"POLDER_SERVER_DIR": "${workspaceFolder}"
			}
		}
	],
	"compounds": [
		{
			"name": "Server + Client",
			"configurations": [
				"Server",
				"Client"
			],
			"stopAll": true
		},
		{
			"name": "Server (Collabora) + Client",
			"configurations": [
				"Server (Collabora)",
				"Client"
			],
			"stopAll": true
		},
		{
			"name": "Server (Euro-Office) + Client",
			"configurations": [
				"Server (Euro-Office)",
				"Client"
			],
			"stopAll": true
		}
	]
}