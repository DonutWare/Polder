{
  "realm": "polder",
  "enabled": true,
  "clients": [
    {
      "clientId": "polder",
      "name": "Polder",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "polder-keycloak-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:6060/*"],
      "webOrigins": ["+"]
